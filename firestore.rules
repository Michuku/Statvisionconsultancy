rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null;
    }
    match /orders/{orderId} {
      // Public visitors submit a new order via "Request Consultation" without
      // being logged in — create is public; managing existing orders stays
      // staff-only. (Previously required auth for create too, which caused
      // a false "could not submit" error for logged-out visitors even though
      // their Formspree email notification still went through.)
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /notifications/{notifId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null;
      allow delete: if false;
    }
    match /chats/{orderId}/messages/{msgId} {
      allow read, write: if request.auth != null;
    }
    match /payroll/{docId} {
      allow read, write: if request.auth != null;
    }
    match /p9forms/{docId} {
      allow read, write: if request.auth != null;
    }
    match /employees/{docId} {
      allow read, write: if request.auth != null;
    }
    match /siteMedia/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /team/{memberId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      match /gallery/{galleryId} {
        allow read: if true;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      match /dashboards/{dashboardId} {
        allow read: if true;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }
    // ===== Phase 3: Content Hubs =====
    // Dashboards & Deliverables Showcase (multi-tool sample previews)
    match /dashboardShowcase/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Portfolio / photo Gallery
    match /galleryItems/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Resources Centre (articles, templates, reports, datasets, training)
    match /resourcesLib/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Blog / Insights posts
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== Phase 4: Booking System (new) =====
    // Public visitors can submit a booking without being logged in.
    // Only admins can read/manage the list (shown in the Admin > Bookings tab).
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
